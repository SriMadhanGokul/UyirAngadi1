{
  "name": "uyirangadi",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "description": "UyirAngadi (உயிர்அங்காடி) - Tamil Nadu animal buying & selling marketplace",
  "scripts": {
    "dev:server": "npm --workspace server run dev",
    "start:server": "npm --workspace server start",
    "seed": "npm --workspace server run seed",
