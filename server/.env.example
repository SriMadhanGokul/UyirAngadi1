NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/uyirangadi

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5173

# Cloudinary is required for user image and video uploads; there is no local fallback.
# The API key must have upload ("create") permission.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uyirangadi

# SMS provider (optional in dev - OTP is logged to console if not set)
SMS_API_KEY=
SMS_SENDER_ID=

# Initial admin seed
ADMIN_PHONE=9999999999
ADMIN_NAME=Admin
